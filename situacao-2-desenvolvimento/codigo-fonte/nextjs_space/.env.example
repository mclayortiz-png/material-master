# MATERIAL MASTER — modelo de variáveis de ambiente
# Copie este arquivo para .env (NUNCA versione o .env) e substitua TODOS os valores abaixo.
# Todos os valores aqui são fictícios.

# Conexão com o banco de dados relacional (PostgreSQL 14+).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://material_master:troque-esta-senha@localhost:5432/material_master?schema=public"

# Segredo de assinatura das sessões (obrigatório). Gere um valor novo por ambiente com:
#   openssl rand -base64 32
# AUTH_SECRET e NEXTAUTH_SECRET devem ter o MESMO valor.
NEXTAUTH_SECRET="substitua-por-um-segredo-aleatorio-de-32-bytes"
AUTH_SECRET="substitua-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação (necessária em produção; em desenvolvimento local pode ficar como abaixo).
NEXTAUTH_URL="http://localhost:3000"

# ---- Contas de demonstração criadas pelo seed (scripts/seed.ts) ----
# Em desenvolvimento, se estas variáveis não forem definidas, o seed usa as senhas padrão
# documentadas (Admin@123, Gestor@123, Consulta@123).
# Em produção (NODE_ENV=production) ou com SEED_SENHAS_ALEATORIAS=true, as senhas padrão NÃO são
# aplicadas: defina senhas fortes abaixo ou o seed gerará senhas aleatórias exibidas uma única vez.
# SEED_SENHA_ADMIN="defina-uma-senha-forte-aqui"
# SEED_SENHA_GESTOR="defina-uma-senha-forte-aqui"
# SEED_SENHA_CONSULTA="defina-uma-senha-forte-aqui"
# SEED_SENHAS_ALEATORIAS=true
# Por padrão, em produção o seed não sobrescreve senhas de usuários já existentes. Para forçar:
# SEED_ATUALIZAR_SENHAS=true

# ---- Testes automatizados (opcional) ----
# URL base usada por scripts/testes-integracao.ts e scripts/testes-e2e.py
# TEST_BASE="http://localhost:3000"

# ---- Proteção contra tentativas repetidas de login ----
# A proteção por conta funciona sem configuração adicional (PostgreSQL obrigatório).
# O banco deve conter a tabela LoginRateLimit criada via Prisma db push/migração
# controlada, antes de publicar a versão nova do código. Nunca recrie a base.
# Com proxy reverso CONFIÁVEL que substitui x-real-ip / cf-connecting-ip /
# x-forwarded-for, é possível ativar também os limites por IP e conta+IP.
# NÃO ative sem validar a origem e a sanitização dos cabeçalhos na hospedagem.
# AUTH_TRUST_PROXY_HEADERS=false
